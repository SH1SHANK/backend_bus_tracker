NODE_ENV=development
PORT=3000
LOG_LEVEL=info

SUPABASE_URL=
# service_role key: server-side ONLY. Never ship to Flutter/ESP32.
SUPABASE_SERVICE_ROLE_KEY=

# >= 32 chars. Generate: openssl rand -base64 48
DEVICE_JWT_SECRET=
DEVICE_JWT_TTL_S=43200

# Comma-separated; leave empty to disable CORS (Flutter native apps don't need it)
CORS_ORIGINS=

SENTRY_DSN=
# If empty, /metrics returns 404
METRICS_TOKEN=

RATE_LIMIT_GLOBAL_PER_MIN=120
RATE_LIMIT_TELEMETRY_PER_MIN=30
RATE_LIMIT_AUTH_PER_MIN=10

# Telemetry validation (defaults: Kerala bbox)
SERVICE_MIN_LAT=8.0
SERVICE_MAX_LAT=12.9
SERVICE_MIN_LON=74.8
SERVICE_MAX_LON=77.5
MAX_SPEED_KMH=120
MAX_ACCURACY_M=100
MAX_PACKET_AGE_S=21600
STOP_RADIUS_M=50
ROUTE_DEVIATION_M=500
